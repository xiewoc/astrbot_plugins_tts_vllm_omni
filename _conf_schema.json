{
    "basic_config": {
        "description": "基础设置",
        "type": "object",
        "items": {
            "base_url": {
                "description": "vLLM 服务器地址",
                "type": "string",
                "default": "http://localhost",
                "hint": "服务器所在主机地址，不含端口"
            },
            "port": {
                "description": "vLLM 服务端口",
                "type": "string",
                "default": "8091",
                "hint": "当访问不了时请检查防火墙"
            },
            "api_key": {
                "description": "API 密钥",
                "type": "string",
                "default": "EMPTY",
                "hint": "vLLM-Omni 默认无需鉴权，填写 EMPTY 即可"
            },
            "timeout": {
                "description": "请求超时时间（秒）",
                "type": "float",
                "default": 300.0,
                "hint": "流式请求与长文本生成建议适当调大"
            },
            "if_random_tts": {
                "description": "是否开启随机文字转语音",
                "type": "bool",
                "default": false
            },
            "random_tts_factor": {
                "description": "随机因子",
                "type": "float",
                "default": 0.4,
                "hint": "因子越大越易触发"
            },
            "max_concurrency": {
                "description": "并发请求上限",
                "type": "int",
                "default": 1,
                "hint": "同时进行的 TTS 请求数量上限，单卡建议保持 1；超出时随机语音会自动跳过而不是排队"
            },
            "retry_times": {
                "description": "失败重试次数",
                "type": "int",
                "default": 1,
                "hint": "请求失败后按 0.5s、1s… 退避重试；配置类错误（如缺少 ref_audio）不会重试"
            }
        }
    },
    "model_config": {
        "description": "模型选择与通用输出",
        "type": "object",
        "items": {
            "use_model": {
                "description": "使用模型",
                "type": "string",
                "options": [
                    "Qwen3-TTS-CustomVoice",
                    "Qwen3-TTS-VoiceDesign",
                    "Qwen3-TTS-Base",
                    "Fish Speech S2 Pro",
                    "Voxtral TTS",
                    "CosyVoice3",
                    "GLM-TTS",
                    "OmniVoice",
                    "VoxCPM2",
                    "MOSS-TTS-Nano",
                    "Higgs Audio v2",
                    "Higgs Audio v3",
                    "IndexTTS-2",
                    "Ming-omni-tts",
                    "Ming-flash-omni-TTS",
                    "SoulX-Singer"
                ],
                "default": "Qwen3-TTS-CustomVoice",
                "hint": "选择后下方会显示该模型专属的配置分节；实际加载的模型仍以 vLLM-Omni 启动参数为准"
            },
            "model": {
                "description": "模型名称（仅日志记录）",
                "type": "string",
                "default": "",
                "hint": "仅供日志展示与本地分派区分，不会上传至服务器"
            },
            "response_format": {
                "description": "音频输出格式",
                "type": "string",
                "options": [
                    "wav",
                    "mp3",
                    "flac",
                    "pcm",
                    "aac",
                    "opus"
                ],
                "default": "wav",
                "hint": "流式模式下强制为 pcm；SoulX-Singer 不使用该字段"
            },
            "stream": {
                "description": "启用流式输出",
                "type": "bool",
                "default": false,
                "hint": "仅部分模型支持（Qwen3 / Fish Speech / GLM / Voxtral / CosyVoice3 / OmniVoice / MOSS / Ming-omni）；不支持或流式采样率未知时插件会回退为非流式并记录警告"
            },
            "stream_format": {
                "description": "流式音频封装格式",
                "type": "string",
                "options": [
                    "audio"
                ],
                "default": "audio",
                "hint": "仅在启用流式输出时随请求发送，官方示例固定为 audio（同时 response_format 会被强制为 pcm）"
            },
            "stream_sample_rate": {
                "description": "流式 PCM 采样率（Hz）",
                "type": "int",
                "default": 0,
                "hint": "0 表示使用内置模型表（Qwen3/GLM 24000、Fish Speech 44100、MOSS-TTS-Nano 48000）；未收录模型采样率未知时会自动回退为非流式，确认采样率后可在此填写以启用流式"
            }
        }
    },
    "qwen3_custom_voice": {
        "description": "Qwen3-TTS-CustomVoice 预设音色",
        "type": "object",
        "condition": {
            "model_config.use_model": "Qwen3-TTS-CustomVoice"
        },
        "items": {
            "voice": {
                "description": "预设音色",
                "type": "string",
                "default": "vivian",
                "hint": "对应 API voice 字段，可用音色可通过 <服务器>/v1/audio/voices 查询，如 vivian、ryan、aiden"
            },
            "language": {
                "description": "语言提示",
                "type": "string",
                "options": [
                    "Auto",
                    "Chinese",
                    "English",
                    "Japanese",
                    "Korean",
                    "German",
                    "French",
                    "Russian",
                    "Portuguese",
                    "Spanish",
                    "Italian"
                ],
                "default": "Auto",
                "hint": "Auto 表示由模型自动判定"
            },
            "instructions": {
                "description": "风格/情感指令",
                "type": "text",
                "default": "",
                "hint": "可选，自由文本补充语气描述"
            },
            "max_new_tokens": {
                "description": "最大生成 Token 数",
                "type": "int",
                "default": 1024,
                "hint": "音频被截断时适量调高，不要超过服务端 --max-model-len"
            },
            "non_streaming_mode": {
                "description": "非流式生成模式",
                "type": "bool",
                "default": true,
                "hint": "Qwen3-TTS 服务端参数，保持开启可避免长文本被切分（官方示例脚本同样开启）"
            }
        }
    },
