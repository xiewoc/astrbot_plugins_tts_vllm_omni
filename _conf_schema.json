            },
            "language": {
                "description": "语言提示",
                "type": "string",
                "options": [
                    "Auto",
                    "Chinese",
                    "English",
                    "Japanese",
                    "Korean",
                    "German",
                    "French",
                    "Russian",
                    "Portuguese",
                    "Spanish",
                    "Italian"
                ],
                "default": "Auto",
                "hint": "Auto 表示由模型自动判定"
            },
            "max_new_tokens": {
                "description": "最大生成 Token 数",
                "type": "int",
                "default": 1024,
                "hint": "音频被截断时适量调高，不要超过服务端 --max-model-len"
            },
            "non_streaming_mode": {
                "description": "非流式生成模式",
                "type": "bool",
                "default": true,
                "hint": "Qwen3-TTS 服务端参数，保持开启可避免长文本被切分（官方示例脚本同样开启）"
            }
