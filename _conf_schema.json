    "qwen3_base": {
        "description": "Qwen3-TTS-Base 音色克隆",
        "type": "object",
        "condition": {
            "model_config.use_model": "Qwen3-TTS-Base"
        },
        "items": {
            "voice": {
                "description": "预计算音色名",
                "type": "string",
                "default": "",
                "hint": "可选：服务端 /v1/audio/voices 中已注册音色，与 ref_audio、speaker_embedding 三选一"
            },
            "ref_audio": {
                "description": "音色参考音频（必填）",
                "type": "file",
                "default": [],
                "file_types": [
                    "wav"
                ],
                "hint": "大小不可超过 10MB 且长度小于 30s；URL 或本地路径均可"
            },
            "ref_text": {
                "description": "参考音频的台词",
                "type": "text",
                "default": "",
                "hint": "与 ref_audio 配套，ICL 模式建议填写"
            },
            "speaker_embedding": {
                "description": "说话人嵌入 JSON",
                "type": "file",
                "default": [],
                "file_types": [
                    "json"
                ],
                "hint": "可替代 ref_audio 的预计算嵌入，维度需与服务端模型匹配"
            },
            "x_vector_only": {
                "description": "仅使用 x-vector 模式",
                "type": "bool",
                "default": false,
                "hint": "开启后请求携带 x_vector_only_mode，关闭 ICL 模式"
            },
            "language": {
                "description": "语言提示",
                "type": "string",
                "options": [
                    "Auto",
                    "Chinese",
                    "English",
                    "Japanese",
                    "Korean",
                    "German",
                    "French",
                    "Russian",
                    "Portuguese",
                    "Spanish",
                    "Italian"
                ],
                "default": "Auto",
                "hint": "Auto 表示由模型自动判定"
            },
            "max_new_tokens": {
                "description": "最大生成 Token 数",
                "type": "int",
                "default": 1024,
                "hint": "音频被截断时适量调高，不要超过服务端 --max-model-len"
            },
            "non_streaming_mode": {
                "description": "非流式生成模式",
                "type": "bool",
                "default": true,
                "hint": "Qwen3-TTS 服务端参数，保持开启可避免长文本被切分（官方示例脚本同样开启）"
            }
        }
    },
