                "type": "text",
                "default": "",
                "hint": "自由文本指令，与 instruction_json 互斥"
            },
            "instruction_json": {
                "description": "结构化指令 JSON",
                "type": "text",
                "default": "",
                "hint": "与 instructions 互斥，填写后优先使用"
            },
            "ref_audio": {
                "description": "音色参考音频",
                "type": "file",
                "default": [],
                "file_types": [
                    "wav"
                ],
                "hint": "支持多个文件（播客式多说话人）；配合 ref_text 中的 speaker_1: 台词 使用"
            },
            "ref_text": {
                "description": "参考音频的台词",
                "type": "text",
                "default": "",
                "hint": "提供 ref_text 时必须同时提供 ref_audio"
            },
            "speaker_embedding": {
                "description": "说话人嵌入 JSON",
                "type": "file",
                "default": [],
                "file_types": [
                    "json"
                ],
                "hint": "192 维 JSON 列表；不能与多个 ref_audio 同时使用"
            },
            "max_new_tokens": {
                "description": "最大生成 Token 数",
                "type": "int",
                "default": 1024,
                "hint": "覆盖服务端 ming_max_decode_steps"
            }
        }
    },
    "ming_flash_omni_tts": {
        "description": "Ming-flash-omni-TTS 风格控制",
        "type": "object",
        "condition": {
            "model_config.use_model": "Ming-flash-omni-TTS"
        },
        "items": {
            "instructions": {
                "description": "风格/情感指令",
                "type": "text",
                "default": "",
                "hint": "自由文本指令，与 instruction_json 互斥"
            },
            "instruction_json": {
                "description": "结构化指令 JSON",
                "type": "text",
                "default": "",
                "hint": "与 instructions 互斥，填写后优先使用"
            }
        }
    },
    "soulxsinger": {
        "description": "SoulX-Singer 歌声合成",
        "type": "object",
        "condition": {
            "model_config.use_model": "SoulX-Singer"
        },
        "items": {
            "language": {
                "description": "演唱语言",
                "type": "string",
                "default": "Mandarin",
                "hint": "如 Mandarin、English、Cantonese；SVC 模式下忽略"
            },
            "control": {
                "description": "条件类型",
                "type": "string",
                "options": [
                    "melody",
                    "score"
                ],
                "default": "melody",
                "hint": "melody 依据旋律生成，score 依据曲谱生成；SVC 模式下忽略"
            },
            "svc": {
                "description": "SVC 歌声转换模式",
                "type": "bool",
                "default": false,
                "hint": "使用 target_audio 中的人声替换音色，此时不发送 language/control"
            },
            "prompt_audio": {
                "description": "提示音频（旋律/歌词条件）",
                "type": "file",
                "default": [],
                "file_types": [
                    "wav"
                ],
                "hint": "本地路径需服务器可见；URL 或 data: URI 会直接透传"
            },
            "target_audio": {
                "description": "目标演唱音频",
                "type": "file",
                "default": [],
                "file_types": [
                    "wav"
                ],
                "hint": "SVC 模式必填；本地路径需服务器可见，URL 或 data: URI 会直接透传"
            },
            "prompt_audio_data_url": {
                "description": "内联提示音频",
                "type": "file",
                "default": [],
                "file_types": [
                    "wav"
                ],
                "hint": "本地 .wav 会转 ascii base64 内联到请求中，适合插件与服务器不在同一台机器"
            },
            "preprocess_weights_dir": {
                "description": "预处理权重目录",
                "type": "string",
                "default": "",
                "hint": "服务端上的集成预处理权重目录，留空使用服务端默认"
            },
            "vocal_sep": {
                "description": "人声分离",
                "type": "bool",
                "default": false,
                "hint": "开启后先从 target_audio 分离人声"
            },
            "auto_shift": {
                "description": "自动变调",
                "type": "bool",
                "default": true,
                "hint": "自动把旋律对齐到目标音域"
            },
            "num_inference_steps": {
                "description": "扩散采样步数",
                "type": "int",
                "default": 32,
                "hint": "越大质量越高、耗时越长"
            },
            "guidance_scale": {
                "description": "CFG 引导强度",
                "type": "float",
                "default": 3.0,
                "hint": "控制对条件音频的贴合程度"
            },
            "seed": {
                "description": "随机种子",
                "type": "int",
                "default": 42,
                "hint": "相同种子输出可复现"
            }
        }
    }
}
